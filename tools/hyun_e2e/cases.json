{
  "about": "현비서 E2E 시나리오 — 사용자 요청 순서(2026-11-07): 네비 모드(반반) → 교통상황 → 휴게소 소개 → 취향 질문 → 웹툰 순위 → 영화 순위 → 스포츠 기사 → 인물 기사 (+ 시동 브리핑 · 주행 중 정찰 · 글레오). 실행·형식 → tools/hyun_e2e/run.py 맨 위",
  "voice_prefix": "현비서야",
  "cases": [
    {
      "id": "e00",
      "title": "시동 — 인사 · 브리핑 순서",
      "why": "새 데이터로 앱을 켜면 순서를 몰라 '뭐부터 들을까요?'를 묻고, 대답한 순서를 저장해 바로 그 순서로 브리핑한다",
      "steps": [
        {"do": "split", "on": false},
        {"do": "restart"},
        {"wait": "reply", "timeout": 45},
        {"do": "say", "text": "날씨 먼저 듣고 그다음 뉴스", "voice": false},
        {"wait": "reply", "timeout": 60},
        {"shot": "시동 브리핑"}
      ],
      "expect": [
        {"log": "event\\|hello", "what": "시동 인사 이벤트"},
        {"log": "say\\|P\\d\\|.*(뭐부터|순서)", "what": "브리핑 순서를 묻는다"},
        {"server": "\"brief_order\": \\[\"weather\"", "what": "대답한 순서(날씨 먼저) 저장"}
      ]
    },
    {
      "id": "e01",
      "title": "네비 모드 — 말로 목적지 · 반반 화면",
      "why": "'현비서야 강남역 가자'(실제 음성 → 받아 적기 → 호출어 → 두뇌)로 내비 경로를 잡고, 앱 영역 2칸으로 왼쪽 현비서 · 오른쪽 내비를 나란히 띄운다",
      "steps": [
        {"do": "say", "text": "강남역 가자", "voice": true},
        {"wait": "log", "pattern": "navi\\|routeStarted", "timeout": 50},
        {"wait": "tts"},
        {"do": "split", "on": true},
        {"wait": "sec", "sec": 4},
        {"shot": "반반 — 왼쪽 현비서 · 오른쪽 내비"}
      ],
      "expect": [
        {"log": "ear\\|wake\\+text\\|.*강남", "what": "귀가 호출어와 목적지를 받아 적음"},
        {"log": "nav\\|강남역", "what": "두뇌가 목적지를 정함"},
        {"log": "navi\\|routeStarted", "what": "내비 경로 시작"}
      ]
    },
    {
      "id": "e02",
      "title": "교통상황 — '앞길 어때?' · 내비 기준 교통 표",
      "why": "내비가 준 내 경로 교통(정체 구간·도로명·속도)을 말로 답하고, 정차 화면에 서버가 내비 값으로 만든 표를 띄운다(반반 화면 그대로)",
      "steps": [
        {"do": "say", "text": "앞길 어때?", "voice": true},
        {"wait": "reply", "timeout": 50},
        {"wait": "sec", "sec": 2},
        {"shot": "교통 표(반반)"}
      ],
      "expect": [
        {"log": "say\\|P1\\|.*(내비|정체|막히|교통)", "what": "내비 기준으로 교통을 말함"},
        {"log": "card\\|앞길 교통", "what": "교통 표 카드"}
      ]
    },
    {
      "id": "e03",
      "title": "휴게소 소개 — 왼쪽 사진 · 오른쪽 표",
      "why": "고속도로 길(대전역)을 잡고 '다음 휴게소 소개해 줘' → 검색으로 확인한 휴게소 정보 + 취향 맞춤 추천을 소개 카드(사진 · 표)로",
      "steps": [
        {"do": "split", "on": false},
        {"do": "say", "text": "대전역 가자", "voice": true},
        {"wait": "log", "pattern": "navi\\|routeStarted", "timeout": 50},
        {"wait": "tts"},
        {"wait": "sec", "sec": 5},
        {"do": "say", "text": "다음 휴게소 소개해 줘", "voice": true},
        {"wait": "reply", "timeout": 75},
        {"wait": "sec", "sec": 4},
        {"shot": "휴게소 소개 카드(전체 화면)"},
        {"do": "split", "on": true},
        {"wait": "sec", "sec": 3},
        {"shot": "휴게소 소개 카드(반반)"}
      ],
      "expect": [
        {"log": "nav\\|대전", "what": "고속도로 목적지 설정"},
        {"log": "card\\|.*휴게소.*kind=info", "what": "휴게소 소개 카드(info)"},
        {"log": "card\\|.*kind=info\\|img=1", "what": "카드에 사진"},
        {"server": "claude\\+search", "what": "검색 모드로 확인"}
      ]
    },
    {
      "id": "e04",
      "title": "취향 질문 — 묻고 · 대답을 취향으로 기록",
      "why": "아직 모르는 취향 칸을 한 번 묻고(asked_slot), 운전자 대답을 그 칸에 누적한다",
      "steps": [
        {"do": "say", "text": "심심한데 나에 대해 하나만 물어봐 줘", "voice": true},
        {"wait": "reply", "timeout": 50},
        {"do": "say", "text": "운전할 땐 아이유 노래 자주 들어", "voice": false},
        {"wait": "reply", "timeout": 50},
        {"shot": "취향 기록 뒤"}
      ],
      "expect": [
        {"server": "\"asked_slot\": \"[a-z]+\"", "what": "취향 질문을 했다(칸 기록)"},
        {"server": "\"taste\": \\[[^\\]]*아이유", "what": "대답을 취향으로 기록(아이유)"}
      ]
    },
    {
      "id": "e05",
      "title": "웹툰 순위 — 표지 격자",
      "why": "정보 통로(네이버 웹툰)의 순위를 앞 3개만 말하고, 10개를 표지 그림 격자로",
      "steps": [
        {"do": "say", "text": "웹툰 순위 알려줘", "voice": true},
        {"wait": "reply", "timeout": 50},
        {"wait": "sec", "sec": 5},
        {"shot": "웹툰 표지 격자(반반)"},
        {"do": "split", "on": false},
        {"wait": "sec", "sec": 3},
        {"shot": "웹툰 표지 격자(전체)"}
      ],
      "expect": [
        {"log": "card\\|.*웹툰.*img=([1-9]|10)", "what": "웹툰 카드에 표지 그림"},
        {"log": "say\\|P1\\|.*", "what": "순위를 말함"}
      ]
    },
    {
      "id": "e06",
      "title": "영화 순위 — 목록 표",
      "why": "영화진흥위원회 박스오피스(어제 기준)를 앞 3개 말하고 10개 목록 표",
      "steps": [
        {"do": "say", "text": "요즘 영화 순위 알려줘", "voice": true},
        {"wait": "reply", "timeout": 50},
        {"wait": "sec", "sec": 2},
        {"shot": "영화 순위 표"}
      ],
      "expect": [
        {"log": "card\\|.*(영화|박스).*kind=list", "what": "영화 순위 목록 카드"},
        {"log": "say\\|P1\\|.*(영화진흥|기준|1위)", "what": "출처·기준을 붙여 말함"}
      ]
    },
    {
      "id": "e07",
      "title": "스포츠 기사 — 웹 검색 모드",
      "why": "통로에 없는 최신 스포츠 소식은 내 Claude 계정 두뇌가 웹 검색으로 찾아 날짜·결과·매체와 함께",
      "steps": [
        {"do": "say", "text": "요즘 야구 소식 알려줘", "voice": true},
        {"wait": "reply", "timeout": 75},
        {"wait": "sec", "sec": 2},
        {"shot": "야구 소식"}
      ],
      "expect": [
        {"server": "claude\\+search", "what": "검색 모드로 답함"},
        {"log": "say\\|P1\\|.{20,}", "what": "소식을 말함"}
      ]
    },
    {
      "id": "e08",
      "title": "인물 기사 — 사진 · 기사 표",
      "why": "인물 근황은 검색해서 소개 카드(왼쪽 인물 사진 — 위키미디어 공용 · 오른쪽 날짜 · 매체 — 기사 요지)",
      "steps": [
        {"do": "say", "text": "손흥민 최근 기사 알려줘", "voice": true},
        {"wait": "reply", "timeout": 75},
        {"wait": "sec", "sec": 4},
        {"shot": "인물 기사 카드(전체)"},
        {"do": "split", "on": true},
        {"wait": "sec", "sec": 3},
        {"shot": "인물 기사 카드(반반)"}
      ],
      "expect": [
        {"server": "claude\\+search", "what": "검색 모드로 답함"},
        {"log": "card\\|.*kind=info\\|img=1", "what": "인물 사진 소개 카드"}
      ]
    },
    {
      "id": "e09",
      "title": "주행 중 — 사고 정찰 · 휴게소 알림",
      "why": "D·60km/h로 달리며 300m 앞 사고(갈림길 없음 → 우회 묻지 않음, 앱 P0 먼저)와 3km 앞 휴게소 알림(말만 — 주행 중 카드 숨김)",
      "steps": [
        {"do": "intent", "extras": "--es dest 대전역 --ef lat 36.3322 --ef lng 127.4343"},
        {"wait": "log", "pattern": "navi\\|routeStarted", "timeout": 40},
        {"do": "vc", "args": ["gear", "Drive"]},
        {"do": "vc", "args": ["speed", "60"]},
        {"wait": "sec", "sec": 4},
        {"do": "intent", "extras": "--es traffic 'accident|300|경부고속도로 1차로 추돌 사고'"},
        {"wait": "reply", "timeout": 45},
        {"do": "intent", "extras": "--es restarea '기흥휴게소|2800'"},
        {"wait": "log", "pattern": "say\\|P\\d\\|.*휴게소", "timeout": 100},
        {"wait": "tts"},
        {"shot": "주행 중 화면"},
        {"do": "vc", "args": ["speed", "0"]},
        {"do": "vc", "args": ["gear", "Park"]}
      ],
      "expect": [
        {"log": "say\\|P0\\|.*사고", "what": "앱이 먼저 사고 경고(P0)"},
        {"log": "scout\\|demo\\|사고\\|sev=3\\|ahead=300\\|detour=(none|possible|unknown)", "what": "우회 타이밍 판정"},
        {"log": "event\\|restarea", "what": "휴게소 알림 이벤트"},
        {"log": "say\\|P\\d\\|.*휴게소", "what": "휴게소를 말로 소개(주행 중 — 카드는 숨김)"}
      ]
    },
    {
      "id": "e10",
      "title": "글레오 — '현비서 지금 상황' 흉내",
      "why": "Gleo Interface 액션(HYUN_STATUS)에 7초 안에 영어 상황 문장으로 응답",
      "steps": [
        {"do": "gleo", "action": "HYUN_STATUS", "param": {"item": "all"}},
        {"wait": "log", "pattern": "gleo\\|response", "timeout": 10},
        {"wait": "sec", "sec": 2},
        {"shot": "글레오 응답"}
      ],
      "expect": [
        {"log": "gleo\\|response\\|.*Heading to", "what": "목적지·남은 시간 영어 응답"}
      ]
    }
  ]
}
